/** 吃郎概览页面样式 **/

/** 1. 页面整体样式 **/
page {
  height: 100%;
  background: linear-gradient(180deg, #8B0000 0%, #6a0000 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding-bottom: 40rpx;
}

.page-back {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 76rpx);
  left: 24rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.page-back-icon {
  font-size: 64rpx;
  line-height: 1;
  color: #ffffff;
}

/** 2. 英雄区域 **/
.hero-section {
  padding: calc(env(safe-area-inset-top) + 216rpx) 40rpx 72rpx;
  text-align: center;
  color: #ffffff;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.4;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.hero-subtitle {
  font-size: 28rpx;
  font-weight: 300;
  opacity: 0.9;
  letter-spacing: 4rpx;
}

/** 3. 菜单卡片容器 **/
.menu-container {
  padding: 0 32rpx;
  margin-bottom: 44rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}

.menu-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.card-icon {
  font-size: 72rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999999;
}

.card-arrow {
  font-size: 64rpx;
  color: #cccccc;
  font-weight: 300;
  line-height: 1;
  margin-left: 16rpx;
}

/** 4. 快速统计区域 **/
.quick-stats {
  display: flex;
  padding: 0 32rpx;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

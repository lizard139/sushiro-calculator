.page { height: 100%; display: flex; flex-direction: column; }
.quiet-button::after, .delete-button::after, .show-all::after { border: none; }
.number-font { font-family: "SF Pro Rounded", "Arial Rounded MT Bold", "DIN Alternate", sans-serif; font-variant-numeric: tabular-nums; font-weight: 500; }
.top-safe { flex: none; }
.page-header { width: 100%; height: 112rpx; padding: 0 40rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; flex: none; }
.page-title { display: block; flex: none; white-space: nowrap; font-size: 48rpx; line-height: 1.1; font-weight: 600; letter-spacing: -1rpx; }
.quiet-button { width: 88rpx; height: 68rpx; margin-left: auto; flex: 0 0 88rpx; box-sizing: border-box; border-radius: 14rpx; background: #f3f5f7; color: #69707a; font-size: 27rpx; font-weight: 500; line-height: 1; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
.content { flex: 1; min-height: 0; padding: 8rpx 40rpx 80rpx; box-sizing: border-box; }
.summary-panel { min-height: 228rpx; padding: 32rpx 34rpx; border-radius: 16rpx; background: #f5f6f8; display: flex; flex-direction: column; justify-content: center; }
.summary-label { color: #717883; font-size: 27rpx; }
.summary-amount { margin: 10rpx 0 12rpx; color: #050609; font-size: 64rpx; line-height: 1; letter-spacing: -2rpx; }
.summary-meta { color: #69717c; font-size: 26rpx; }
.list-heading-row { margin: 38rpx 0 10rpx; display: flex; align-items: center; justify-content: space-between; }
.section-heading { font-size: 36rpx; font-weight: 720; }
.clear-all { padding: 18rpx 0 18rpx 24rpx; color: #d71920; font-size: 24rpx; }
.record-row { min-height: 128rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e5e8eb; }
.record-icon { width: 68rpx; height: 68rpx; margin-right: 24rpx; border-radius: 50%; background: #f2f4f6; position: relative; flex: none; }
.record-icon::before { content: ''; position: absolute; left: 20rpx; top: 16rpx; width: 27rpx; height: 34rpx; border: 3rpx solid #858c96; border-radius: 4rpx; box-sizing: border-box; }
.icon-line { position: relative; z-index: 1; width: 14rpx; height: 3rpx; margin: 0 0 5rpx 27rpx; top: 24rpx; border-radius: 2rpx; background: #858c96; }
.icon-line.short { width: 10rpx; }
.record-copy { flex: 1; min-width: 0; }
.record-date-line { display: flex; align-items: baseline; gap: 14rpx; white-space: nowrap; }
.record-date { font-size: 29rpx; font-weight: 650; white-space: nowrap; }
.record-time { font-size: 25rpx; color: #111318; white-space: nowrap; }
.record-meta { display: block; margin-top: 8rpx; color: #7a818b; font-size: 25rpx; white-space: nowrap; }
.record-amount { margin-left: 18rpx; font-size: 36rpx; color: #0b0c0e; white-space: nowrap; flex: none; }
.record-arrow { margin-left: 18rpx; color: #9299a3; font-size: 48rpx; font-weight: 300; }
.delete-button { width: 88rpx; height: 68rpx; margin-left: 18rpx; flex: 0 0 88rpx; box-sizing: border-box; border-radius: 12rpx; background: #fff1f1; color: #d71920; font-size: 24rpx; line-height: 1; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
.show-all { width: 100%; height: 82rpx; margin: 30rpx 0 0; border-radius: 14rpx; background: #f5f6f8; color: #d71920; font-size: 27rpx; font-weight: 620; line-height: 82rpx; }
.show-all-arrow { float: right; margin-right: 24rpx; color: #8d949e; font-size: 40rpx; }
.receipt-modal { position: fixed; top: 0; left: 0; right: 0; z-index: 40; background: rgba(15,18,22,.56); opacity: 0; transition: opacity 220ms cubic-bezier(.22, 1, .36, 1); }
.receipt-modal.is-visible { opacity: 1; }
@media (prefers-reduced-motion: reduce) { .receipt-modal { transition: none; } }
.receipt-dialog { position: absolute; top: 50%; left: 28rpx; right: 28rpx; transform: translateY(-50%); display: flex; flex-direction: column; border-radius: 16rpx; overflow: hidden; background: #fff; }
.modal-heading { height: 88rpx; padding: 0 28rpx; flex: none; display: flex; align-items: center; justify-content: space-between; font-size: 31rpx; font-weight: 700; border-bottom: 1rpx solid #e8ebee; }
.modal-close { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: #69717b; font-size: 46rpx; font-weight: 300; }
.modal-scroll { flex: 1; min-height: 0; }
.receipt-paper { padding: 38rpx 32rpx 42rpx; background: #fff; }
.receipt-header { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.receipt-title { font-size: 36rpx; font-weight: 720; }
.receipt-muted { color: #707883; font-size: 22rpx; }
.receipt-rule { margin: 26rpx 0; border-top: 2rpx dashed #ccd2d9; }
.receipt-rule.strong { border-top-style: solid; border-color: #aeb5bd; }
.receipt-section-title { display: block; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 680; }
.receipt-item { min-height: 58rpx; display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #e8ebee; font-size: 25rpx; }
.receipt-name { flex: 1; min-width: 0; }
.receipt-detail { color: #707883; }
.receipt-value { min-width: 92rpx; text-align: right; }
.receipt-summary { min-height: 50rpx; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; color: #30343a; }
.discount-value { color: #d71920; }
.receipt-total { display: flex; align-items: baseline; justify-content: space-between; font-size: 36rpx; font-weight: 720; }
.receipt-total .number-font { font-size: 48rpx; }
.receipt-info { display: flex; justify-content: space-between; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx dashed #ccd2d9; font-size: 24rpx; }
.receipt-thanks { display: block; margin-top: 32rpx; text-align: center; color: #727a84; font-size: 23rpx; }
.receipt-actions { padding: 20rpx; display: flex; gap: 16rpx; flex: none; background: #f3f5f7; }
.receipt-button { flex: 1; height: 76rpx; margin: 0; padding: 0; border-radius: 12rpx; font-size: 27rpx; line-height: 1; display: flex; align-items: center; justify-content: center; }
.receipt-button::after { border: none; }
.receipt-button.secondary { background: #fff; color: #d71920; border: 2rpx solid #d71920; }
.receipt-button.primary { background: #d71920; color: #fff; }
.empty-state { min-height: 430rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-receipt { width: 72rpx; height: 86rpx; margin-bottom: 24rpx; border: 4rpx solid #c3c8cf; border-radius: 8rpx; box-sizing: border-box; }
.empty-line { width: 32rpx; height: 4rpx; margin: 14rpx auto -4rpx; border-radius: 2rpx; background: #c3c8cf; }
.empty-title { font-size: 29rpx; font-weight: 650; }
.empty-copy { max-width: 430rpx; margin-top: 12rpx; color: #7b828c; font-size: 24rpx; line-height: 1.6; }
.content-spacer { height: 36rpx; }
.export-canvas { position: fixed; left: -10000px; top: -10000px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
@media (max-width: 350px) { .page-header, .content { padding-left: 28rpx; padding-right: 28rpx; } .page-title { font-size: 42rpx; } }

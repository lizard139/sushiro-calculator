.settings-page {
  min-height: 100vh;
  background-color: #F7F3E9;
  padding: 24rpx;
  box-sizing: border-box;
}

.settings-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.settings-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.settings-row.row-between {
  justify-content: space-between;
}

.settings-label {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

.settings-input {
  width: 240rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  background-color: #ffffff;
  text-align: right;
}

.settings-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.reset-btn {
  flex: 1;
  background-color: #f5f5f5;
  color: #333333;
  border-radius: 30rpx;
}

.reset-btn::after {
  border: none;
}

.save-btn {
  flex: 1;
  background-color: #8B0000;
  color: #ffffff;
  border-radius: 30rpx;
}

.save-btn::after {
  border: none;
}



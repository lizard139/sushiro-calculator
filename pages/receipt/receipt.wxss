.page { height: 100%; display: flex; flex-direction: column; background: #f2f5f7; }
.more-button::after, .action-button::after { border: none; }
.number-font { font-family: "SF Pro Rounded", "Arial Rounded MT Bold", "DIN Alternate", sans-serif; font-variant-numeric: tabular-nums; font-weight: 500; }
.top-safe { flex: none; }
.nav-bar { height: 96rpx; padding: 0 34rpx; display: grid; grid-template-columns: 112rpx 1fr 112rpx; align-items: center; flex: none; }
.back-button { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: flex-start; color: #6f7782; }
.back-glyph { font-size: 66rpx; line-height: 1; font-weight: 300; transform: translateY(-4rpx); }
.nav-title { text-align: center; font-size: 34rpx; font-weight: 720; }
.more-button { width: 112rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 14rpx; background: #e9edf0; color: #69717b; font-size: 26rpx; line-height: 64rpx; }
.content { flex: 1; min-height: 0; padding: 24rpx 36rpx max(28rpx, env(safe-area-inset-bottom)); box-sizing: border-box; }
.receipt-paper { position: relative; padding: 66rpx 34rpx 58rpx; background: #fff; }
.tear-edge { position: absolute; left: 0; width: 100%; height: 16rpx; background-size: 24rpx 24rpx; background-repeat: repeat-x; }
.top-edge { top: -8rpx; background-image: radial-gradient(circle at 12rpx 0, #f2f5f7 9rpx, transparent 10rpx); }
.bottom-edge { bottom: -8rpx; transform: rotate(180deg); background-image: radial-gradient(circle at 12rpx 0, #f2f5f7 9rpx, transparent 10rpx); }
.receipt-header { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.receipt-title { margin-bottom: 12rpx; font-size: 40rpx; font-weight: 750; }
.receipt-muted { color: #707883; font-size: 23rpx; }
.receipt-rule { margin: 32rpx 0; border-top: 2rpx dashed #ccd2d9; }
.receipt-rule.strong { border-top-style: solid; border-color: #aeb5bd; }
.section-title { display: block; margin-bottom: 14rpx; font-size: 30rpx; font-weight: 720; }
.item-row { min-height: 72rpx; display: grid; grid-template-columns: 1fr auto 120rpx; column-gap: 16rpx; align-items: center; border-bottom: 1rpx solid #e8ebee; font-size: 27rpx; }
.item-name { font-weight: 600; }
.item-detail { color: #707883; }
.item-value { text-align: right; font-size: 29rpx; }
.summary-row { min-height: 52rpx; display: flex; align-items: center; justify-content: space-between; color: #30343a; font-size: 26rpx; }
.discount-value { color: #d71920; }
.total-row { display: flex; align-items: baseline; justify-content: space-between; font-size: 38rpx; font-weight: 750; }
.total-row .number-font { font-size: 54rpx; }
.people-row { margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx dashed #ccd2d9; display: flex; justify-content: space-between; font-size: 26rpx; }
.thanks { display: block; margin-top: 48rpx; text-align: center; color: #727a84; font-size: 24rpx; }
.actions { margin-top: 34rpx; display: flex; gap: 18rpx; }
.action-button { flex: 1; height: 84rpx; margin: 0; padding: 0; border-radius: 14rpx; font-size: 29rpx; font-weight: 650; line-height: 1; display: flex; align-items: center; justify-content: center; }
.action-button.secondary { border: 2rpx solid #d71920; background: #fff; color: #d71920; }
.action-button.primary { background: #d71920; color: #fff; }
.save-hint { display: block; margin-top: 18rpx; color: #7a828c; font-size: 22rpx; text-align: center; }
.content-spacer { height: 28rpx; }
.export-canvas { position: fixed; left: -10000px; top: -10000px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
